# ==========================================================================
# Vegas Magic Squad — Netlify headers
# ==========================================================================
# This lives here rather than in netlify.toml on purpose. A drag-and-drop
# deploy of dist/ never reads netlify.toml, but it does read a _headers file
# sitting in the published folder — and build.js copies this one in. So the
# same rules apply whether the site is dropped, pushed from the CLI, or built
# from a git connection. One source of truth.
#
# Filenames here carry no content hash, so anything cached hard is stuck
# until its name changes. The split below follows exactly that line.
# ==========================================================================

# --------------------------------------------------------------------------
# Security — applies to everything
# --------------------------------------------------------------------------
# Deliberately no Content-Security-Policy yet. The page carries inline style
# attributes (the .strike tiers use style="--s:1"), so a working CSP needs
# style-src 'unsafe-inline', and a policy loosened enough to pass is worth
# less than the time spent debugging it. Worth writing properly once the
# booking form talks to a real endpoint and its origins are known.
# >>> REMOVE THE X-Robots-Tag LINE BELOW TO GO LIVE <<<
# The page currently ships visible placeholders: three reviews it labels as
# not real, a phone and email it labels as placeholders, a form that delivers
# nothing, and eight client logos carried over from another performer's site.
# Indexing that under the business name is the one mistake here that is hard
# to take back, so search engines are told to stay away until it is finished.
# Deleting the single X-Robots-Tag line re-opens the site to indexing.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# --------------------------------------------------------------------------
# The page and its two unhashed source files
# --------------------------------------------------------------------------
# Edited in place on every change, so a long cache would serve stale CSS to
# anyone who visited before the deploy. Netlify sends an ETag, so the
# revalidation is a 304 and costs next to nothing.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/script.js
  Cache-Control: public, max-age=0, must-revalidate

# --------------------------------------------------------------------------
# Subset fonts and the pinned GSAP build
# --------------------------------------------------------------------------
# Replaced by adding a differently-named file, never by editing one, so a
# year is safe.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# --------------------------------------------------------------------------
# Photography
# --------------------------------------------------------------------------
# A month, not a year: these do get swapped for a better frame under the same
# filename, and a year of stale hero image is a bad trade for a few extra
# cache hits.
/images/*
  Cache-Control: public, max-age=2592000

# --------------------------------------------------------------------------
# Showreel clips
# --------------------------------------------------------------------------
# The heaviest thing on the site by far, and the least likely to be re-cut
# under the same filename. Cached hard so a second viewing costs nothing.
# Nothing here is fetched until a visitor actually presses play.
/video/*
  Cache-Control: public, max-age=31536000, immutable
